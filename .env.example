# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://ylgvwzwmgeiuyhomxvuh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# Server-only. Required to CONFIRM/settle payments (mark_order_payment is
# service-role only). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI assistant (Phase 6) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Payments (Phase 8) ───────────────────────────────────────────────────────
# With NONE of these set, payments run in MOCK mode: the flow works end-to-end
# and auto-confirms after MOCK_PAY_DELAY_MS. Set the real keys to go live.
MOCK_PAY_DELAY_MS=4000

# MTN Mobile Money — https://momodeveloper.mtn.com
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENV=sandbox         # 'sandbox' or 'mtncameroon'
MOMO_CURRENCY=XAF               # sandbox requires EUR; production Cameroon uses XAF
MOMO_API_USER=
MOMO_API_KEY=
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=

# Orange Money Web Payment (Cameroon) — https://developer.orange.com
ORANGE_OAUTH_URL=https://api.orange.com/oauth/v3/token
ORANGE_BASE_URL=https://api.orange.com/orange-money-webpay/cm/v1
ORANGE_CURRENCY=XAF
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=

# ── Notifications fan-out (Phase 7) ──────────────────────────────────────────
# These are SUPABASE EDGE FUNCTION secrets, NOT Vercel env vars. Set with:
#   supabase secrets set RESEND_API_KEY=... RESEND_FROM="Chez Marie <no-reply@domain>"
#   supabase secrets set TWILIO_ACCOUNT_SID=... TWILIO_AUTH_TOKEN=... TWILIO_FROM=+1...
# With none set, the notify-fanout function runs in mock mode (records status only).
# RESEND_API_KEY, RESEND_FROM, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM
